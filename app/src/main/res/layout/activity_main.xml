<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MainActivity">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingBottom="10dp"
                android:src="@drawable/logo" />

            <TextView
                android:id="@+id/actTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:text="Extended Activity" />

            <TextView
                style="@style/SectionHeader"
                android:layout_marginTop="0dp"
                android:text="Payment" />

            <EditText
                android:id="@+id/edtAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/edtTracking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tracking No" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/edtSMS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="SMS"
                android:imeOptions="actionDone"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnPay"
                style="@style/PayableButton"
                android:drawableLeft="@drawable/ic_credit_card_black_24dp"
                android:drawablePadding="-20dp"
                android:text="Pay" />

            <Button
                android:id="@+id/btnPayCard"
                style="@style/PayableButton"
                android:drawableLeft="@drawable/ic_credit_card_black_24dp"
                android:drawablePadding="-20dp"
                android:text="Charge Card" />

            <Button
                android:id="@+id/btnPayWallet"
                style="@style/PayableButton"
                android:drawableLeft="@drawable/ic_credit_card_black_24dp"
                android:drawablePadding="-20dp"
                android:text="Charge Wallet" />

            <Button
                android:id="@+id/btnProfile"
                style="@style/PayableButton"
                android:text="Selected Profile: Default" />

            <TextView
                style="@style/SectionHeader"
                android:text="Transaction" />

            <EditText
                android:id="@+id/edtTxnId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Transaction ID to Void/Status"
                android:imeOptions="actionDone"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnVoid"
                style="@style/PayableButton"
                android:text="Void Transaction" />

            <Button
                android:id="@+id/btnStatus"
                style="@style/PayableButton"
                android:text="Transaction Status (Txn ID)" />

            <EditText
                android:id="@+id/edtOrderId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Order Tracking ID to Get Status"
                android:imeOptions="actionDone" />

            <Button
                android:id="@+id/btnStatusV2"
                style="@style/PayableButton"
                android:text="Transaction Status (Order ID)" />

            <TextView
                style="@style/SectionHeader"
                android:text="Settlement &amp; Reversal" />

            <Button
                android:id="@+id/btnSettlementHistory"
                style="@style/PayableButton"
                android:text="Settlement History" />

            <Button
                android:id="@+id/btnTransactionHistory"
                style="@style/PayableButton"
                android:text="Transaction History (3 days)" />

            <Button
                android:id="@+id/btnLatestReversal"
                style="@style/PayableButton"
                android:text="Latest Reversal Record" />

            <Button
                android:id="@+id/btnForceReversal"
                style="@style/PayableButton"
                android:enabled="false"
                android:text="Force Reversal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionHeader"
                    android:layout_width="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:text="Response" />

                <Button
                    android:id="@+id/btnClearResponse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="8dp"
                    android:text="Clear"
                    android:textAllCaps="false"
                    android:textColor="@color/payable_blue"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/response_background"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="@color/response_text"
                android:textIsSelectable="true"
                android:textSize="12sp" />

        </LinearLayout>

    </ScrollView>

</RelativeLayout>
